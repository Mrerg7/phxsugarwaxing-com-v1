---
import AcquisitionCTA from '../components/AcquisitionCTA.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Nav from '../components/Nav.astro';
import SugarWaxingSection from '../components/SugarWaxingSection.astro';
import UseCasesSection from '../components/UseCasesSection.astro';
import WhySection from '../components/WhySection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CF_IMAGES, cfImageUrl } from '../config/site';
---

<BaseLayout includeFaq preloadImage={cfImageUrl(CF_IMAGES.heroImageId)}>
  <Nav />
  <main id="main">
    <Hero />
    <WhySection />
    <SugarWaxingSection />
    <UseCasesSection />
    <FaqSection />
    <AcquisitionCTA />
  </main>
  <Footer />
</BaseLayout>
