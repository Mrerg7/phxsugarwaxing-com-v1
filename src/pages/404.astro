---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | phxsugarwaxing.com"
  description="That page does not exist. The domain phxsugarwaxing.com is still for sale."
  noindex={true}
>
  <Nav />
  <main id="main" class="min-h-[70vh] flex items-center justify-center px-6 py-20">
    <div class="text-center max-w-md">
      <p class="modern-pill inline-block mb-4">404</p>
      <h1 class="font-display text-4xl tracking-tight mb-4">Page not found</h1>
      <p class="text-[#5C5C5C] mb-8">The domain is still for sale. This address is not.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/"
          class="inline-flex items-center justify-center min-h-12 px-8 py-3 bg-[#B85C38] hover:bg-[#A04E30] text-white font-semibold rounded-2xl"
        >
          Return home
        </a>
        <a
          href="/acquire/#inquire"
          class="inline-flex items-center justify-center min-h-12 px-8 py-3 border border-[#D4C9B8] bg-white font-semibold rounded-2xl"
        >
          Make an offer
        </a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
