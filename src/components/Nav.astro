---
import Icon from './Icon.astro';

const links = [
  { href: '/#why', label: 'Why this name' },
  { href: '/phoenix-sugar-waxing/', label: 'Phoenix search' },
  { href: '/#uses', label: 'Uses' },
  { href: '/#faq', label: 'FAQ' },
];
---

<nav class="bg-white/95 backdrop-blur-md border-b border-[#EDE4D7] sticky top-0 z-50" id="site-nav">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-x-2 min-w-0">
        <div class="w-9 h-9 bg-[#B85C38] rounded-2xl flex items-center justify-center shrink-0">
          <span class="text-white text-sm font-bold tracking-tighter">PSW</span>
        </div>
        <div class="truncate">
          <span class="font-semibold text-lg tracking-tight">phxsugarwaxing</span>
          <span class="font-semibold text-lg tracking-tight text-[#B85C38]">.com</span>
        </div>
      </a>

      <div class="flex items-center gap-x-1 shrink-0">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="hidden lg:inline-flex items-center px-3 py-2 text-sm font-medium text-[#4A5D4A] hover:text-[#2D2D2D] min-h-11"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="/acquire/#inquire"
          class="hidden sm:inline-flex items-center justify-center min-h-11 px-4 bg-[#B85C38] hover:bg-[#A04E30] text-white text-sm font-semibold rounded-2xl"
        >
          Make an offer
        </a>
        <button
          type="button"
          id="menu-btn"
          class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-2xl border border-[#EDE4D7]"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="sr-only">Open menu</span>
          <Icon name="fa-bars" class="w-5 h-5 menu-icon-open" />
          <Icon name="fa-xmark" class="w-5 h-5 menu-icon-close hidden" />
        </button>
      </div>
    </div>
  </div>
  <div id="mobile-menu" class="lg:hidden hidden border-t border-[#EDE4D7] bg-white">
    <div class="max-w-6xl mx-auto px-4 py-2 flex flex-col">
      {
        links.map((link) => (
          <a href={link.href} class="py-3 text-base font-medium border-b border-[#F3EBE1] min-h-11 flex items-center">
            {link.label}
          </a>
        ))
      }
      <a href="/acquire/#inquire" class="py-3 text-base font-semibold text-[#B85C38] min-h-11 flex items-center">
        Make an offer
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('site-nav');
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    nav?.classList.toggle('nav-scrolled', window.scrollY > 20);
  }, { passive: true });

  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    btn.querySelector('.menu-icon-open')?.classList.toggle('hidden', open);
    btn.querySelector('.menu-icon-close')?.classList.toggle('hidden', !open);
    const label = btn.querySelector('.sr-only');
    if (label) label.textContent = open ? 'Close menu' : 'Open menu';
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      btn?.querySelector('.menu-icon-open')?.classList.remove('hidden');
      btn?.querySelector('.menu-icon-close')?.classList.add('hidden');
    });
  });
</script>
