---
import Icon from './Icon.astro';
import { cfImageUrl, CF_IMAGES } from '../config/site';

const heroImage = cfImageUrl(CF_IMAGES.heroImageId);
---

<header class="relative min-h-[100svh] flex items-center justify-center overflow-hidden">
  <img
    src={heroImage}
    alt="Soft editorial photograph behind the phxsugarwaxing.com for-sale headline"
    width="1366"
    height="745"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 z-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 z-[1] bg-gradient-to-b from-black/70 via-black/55 to-[#F8F1E9]" aria-hidden="true"></div>

  <div class="relative z-[2] w-full max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-28 sm:pb-24 text-center">
    <p class="inline-flex items-center gap-2 mb-5 px-3 py-1.5 rounded-full bg-white/95 text-[#B85C38] text-xs font-bold tracking-[0.14em]">
      <Icon name="fa-shield" class="w-3.5 h-3.5" />
      DOMAIN FOR SALE
    </p>

    <h1 class="domain-name mb-4 text-white drop-shadow-md">phxsugarwaxing.com</h1>

    <p class="max-w-2xl mx-auto text-xl sm:text-3xl font-semibold tracking-tight text-white mb-4">
      The exact-match name for Phoenix sugar waxing.
    </p>

    <p class="max-w-xl mx-auto text-base sm:text-lg text-white/90 mb-8">
      For sale to a salon, mobile service, school, or brand that wants the phrase clients already use — on a .com.
      This page does not book appointments.
    </p>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 max-w-md sm:max-w-none mx-auto">
      <a
        href="/acquire/#inquire"
        class="inline-flex items-center justify-center gap-2 w-full sm:w-auto min-h-12 px-8 py-3 bg-[#B85C38] hover:bg-[#A04E30] text-white font-semibold text-base rounded-3xl shadow-lg shadow-black/20"
      >
        Make an offer
        <Icon name="fa-arrow-right" class="w-4 h-4" />
      </a>
      <a
        href="/#why"
        class="inline-flex items-center justify-center w-full sm:w-auto min-h-12 px-8 py-3 border border-white/50 bg-black/20 hover:bg-black/30 text-white font-semibold text-base rounded-3xl"
      >
        Why buyers want it
      </a>
    </div>

    <ul class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-2.5 sm:gap-6 text-sm text-white">
      <li class="flex items-center gap-1.5"><Icon name="fa-check" class="w-4 h-4 text-[#F3C7B0]" /> PHX + sugar waxing</li>
      <li class="flex items-center gap-1.5"><Icon name="fa-check" class="w-4 h-4 text-[#F3C7B0]" /> Escrow-ready .com transfer</li>
      <li class="flex items-center gap-1.5"><Icon name="fa-check" class="w-4 h-4 text-[#F3C7B0]" /> Reply within one business day</li>
    </ul>
  </div>
</header>
