---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const benefits = (await getCollection('benefits')).sort((a, b) => a.data.order - b.data.order);
---

<section id="sugarwaxing" class="bg-white border-y border-[#EDE4D7]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 md:py-20">
    <div class="text-center mb-10">
      <div class="modern-pill inline-block mb-3">THE SERVICE THE NAME DESCRIBES</div>
      <h2 class="section-header tracking-tight">Sugar waxing, in plain language</h2>
    </div>

    <div class="max-w-3xl mx-auto text-[#4A5D4A] space-y-4 text-base sm:text-lg leading-relaxed">
      <p>
        Sugar waxing, also called sugaring, uses a paste made mostly of sugar, lemon juice, and water.
        It is applied near room or body temperature, so it does not carry the burn risk of hot wax.
        The paste is water-soluble and wipes off without a heavy solvent.
      </p>
      <p>
        Studios market it as a gentler option for sensitive skin. That is the category
        <strong class="font-semibold text-[#2D2D2D]">phxsugarwaxing.com</strong> names directly.
        <a href="/phoenix-sugar-waxing/" class="text-[#B85C38] font-semibold underline underline-offset-2">See the Phoenix search patterns</a>
        a buyer would be stepping into.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-5 mt-12">
      {
        benefits.map(({ data }) => (
          <article class="clean-section rounded-3xl p-6 sm:p-8">
            <h3 class="font-semibold text-base sm:text-lg mb-3 flex items-center gap-x-3">
              <span class="w-10 h-10 bg-[#F8F1E9] rounded-full flex items-center justify-center shrink-0 text-[#B85C38]">
                <Icon name={data.icon} class="w-5 h-5" />
              </span>
              <span>{data.title}</span>
            </h3>
            <p class="text-[#5C5C5C] text-sm sm:text-base leading-relaxed">{data.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
