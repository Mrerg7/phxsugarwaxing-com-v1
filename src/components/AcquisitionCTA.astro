---
import InquiryForm from './InquiryForm.astro';
import { ACQUISITION_MAILTO, SITE } from '../config/site';
---

<section id="inquire" class="bg-[#2D2D2D] text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
    <div class="grid lg:grid-cols-[1fr_1.05fr] gap-10 items-start">
      <div>
        <p class="text-xs font-bold tracking-[0.18em] text-[#E8A07A] mb-4">PRIVATE OFFERS</p>
        <h2 class="font-display text-3xl sm:text-5xl tracking-tight leading-tight mb-5">
          Make an offer on phxsugarwaxing.com
        </h2>
        <p class="text-white/75 text-base sm:text-lg leading-relaxed mb-6">
          No public price. No auction. Tell the seller what you will pay and how you will use the name.
          Escrow.com, or another escrow service you both accept, is the preferred way to pay.
        </p>
        <ol class="space-y-3 text-sm sm:text-base text-white/85 mb-8">
          <li class="flex gap-3"><span class="text-[#E8A07A] font-bold">1</span> Send the offer. Expect a reply within one business day.</li>
          <li class="flex gap-3"><span class="text-[#E8A07A] font-bold">2</span> Agree on price and escrow.</li>
          <li class="flex gap-3"><span class="text-[#E8A07A] font-bold">3</span> Start the .com transfer at your registrar. The seller approves it.</li>
        </ol>
        <p class="text-sm text-white/60">
          Prefer your own mail app?
          <a class="text-white underline underline-offset-2" href={ACQUISITION_MAILTO}>{SITE.email}</a>
        </p>
      </div>
      <div class="rounded-3xl bg-[#F8F1E9] text-[#2D2D2D] p-5 sm:p-8">
        <InquiryForm id="offer-form-home" />
      </div>
    </div>
  </div>
</section>
