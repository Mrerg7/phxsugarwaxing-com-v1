---
import { DISCLAIMER_DATE, SITE } from '../config/site';

const links = [
  { href: '/#why', label: 'Why this name' },
  { href: '/phoenix-sugar-waxing/', label: 'Phoenix sugar waxing' },
  { href: '/acquire/', label: 'Make an offer' },
  { href: '/#faq', label: 'FAQ' },
];
---

<footer class="relative z-10 border-t border-[#EDE4D7] bg-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8 mb-8">
      <div>
        <p class="font-semibold text-lg">phxsugarwaxing<span class="text-[#B85C38]">.com</span></p>
        <p class="mt-2 text-sm text-[#5C5C5C] max-w-sm">Premium domain for sale. Not a salon. No appointments.</p>
        <a class="mt-3 inline-block text-sm font-semibold text-[#B85C38]" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
      <nav aria-label="Footer" class="flex flex-col gap-2 text-sm">
        {links.map((link) => (
          <a class="min-h-11 md:min-h-0 flex items-center hover:text-[#B85C38]" href={link.href}>{link.label}</a>
        ))}
      </nav>
    </div>

    <p class="text-xs text-[#6B6B6B] leading-relaxed max-w-4xl">
      phxsugarwaxing.com is offered for acquisition as a domain name only. This website does not sell sugar waxing
      appointments or products. Transfer timing depends on the registrars and escrow service involved. Page content is
      current as of {DISCLAIMER_DATE}.
    </p>

    <div class="pt-6 mt-6 border-t border-[#EDE4D7] text-xs text-[#6B6B6B] flex flex-col sm:flex-row gap-2 sm:justify-between">
      <p>© {new Date().getFullYear()} phxsugarwaxing.com</p>
      <p>{SITE.location}</p>
    </div>
  </div>
</footer>
