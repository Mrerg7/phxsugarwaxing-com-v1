---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const valueProps = (await getCollection('valueProps')).sort((a, b) => a.data.order - b.data.order);
---

<section id="why" class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
  <div class="text-center mb-10 max-w-3xl mx-auto">
    <div class="modern-pill inline-block mb-3">WHY THE NAME SELLS</div>
    <h2 class="section-header tracking-tight">A Phoenix sugar waxing address buyers can say out loud</h2>
    <p class="mt-4 text-[#5C5C5C] text-base leading-relaxed">
      Domain Authority is not a dial on this page. Moz DA and Ahrefs DR move when other sites link to you.
      The sale here is the exact-match .com, plus a fast mobile site you can keep or replace.
      <a href="/phoenix-sugar-waxing/" class="text-[#B85C38] font-semibold underline underline-offset-2">Read how Phoenix clients search</a>.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 gap-5">
    {
      valueProps.map(({ data }) => (
        <article class="value-card clean-section rounded-3xl p-6 sm:p-8">
          <div class="w-11 h-11 bg-[#F8F1E9] rounded-2xl flex items-center justify-center mb-5 text-[#B85C38]">
            <Icon name={data.icon} class="w-5 h-5" />
          </div>
          <h3 class="font-semibold text-lg sm:text-xl tracking-tight mb-2">{data.title}</h3>
          <p class="text-[#5C5C5C] leading-relaxed text-sm sm:text-base">{data.description}</p>
        </article>
      ))
    }
  </div>
</section>
