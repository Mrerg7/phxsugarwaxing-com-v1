---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'w-5 h-5' } = Astro.props;

const icons: Record<string, string> = {
  'fa-search': '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.2-3.2"/>',
  'fa-leaf': '<path d="M5 19c8 0 14-8 14-14-6 0-14 6-14 14z"/><path d="M8 16c2-2 4-5 6-8"/>',
  'fa-globe': '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.8 3.8 5.8 3.8 9s-1.3 6.2-3.8 9c-2.5-2.8-3.8-5.8-3.8-9S9.5 5.8 12 3z"/>',
  'fa-hand-paper': '<path d="M8 11V6.5a1.5 1.5 0 0 1 3 0V11"/><path d="M11 10V5.5a1.5 1.5 0 0 1 3 0V11"/><path d="M14 10.5V7.5a1.5 1.5 0 0 1 3 0V14c0 3-2 6-6 6-3.2 0-5-2-5.5-4L4.8 13a1.4 1.4 0 0 1 2.4-1.4L8 13"/>',
  'fa-check-double': '<path d="M2 12.5l4 4 8-9"/><path d="M11 13.5l1.5 1.5 8-9"/>',
  'fa-clock': '<circle cx="12" cy="12" r="9"/><path d="M12 7v6l4 2"/>',
  'fa-store': '<path d="M4 10l1.2-5h13.6L20 10"/><path d="M4 10h16v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9z"/><path d="M9 20v-5h6v5"/>',
  'fa-mobile-screen-button': '<rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/>',
  'fa-graduation-cap': '<path d="M3 9.5L12 5l9 4.5-9 4.5L3 9.5z"/><path d="M7 12v4.5c0 .8 2.2 2.5 5 2.5s5-1.7 5-2.5V12"/>',
  'fa-flask': '<path d="M9 3h6"/><path d="M10 3v6L5.5 18A3 3 0 0 0 8 22h8a3 3 0 0 0 2.5-4L14 9V3"/><path d="M8 14h8"/>',
  'fa-calendar-check': '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M8 3.5V7M16 3.5V7M3.5 10h17"/><path d="M9 15.5l2 2 4-4"/>',
  'fa-bolt': '<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>',
  'fa-arrow-right': '<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>',
  'fa-chevron-down': '<path d="M6 9l6 6 6-6"/>',
  'fa-check': '<path d="M5 12.5l4.5 4.5L19 7"/>',
  'fa-bars': '<path d="M4 7h16M4 12h16M4 17h16"/>',
  'fa-xmark': '<path d="M6 6l12 12M18 6L6 18"/>',
  'fa-envelope': '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 7l8 6 8-6"/>',
  'fa-shield': '<path d="M12 3l8 3v6c0 4.5-3.2 7.6-8 9-4.8-1.4-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/>',
};

const inner = icons[name] ?? icons['fa-leaf'];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={inner}
></svg>
